# Copy to .env and fill in. Never commit .env.

# --- Calendar Service ---
CALENDAR_DB_URL=postgresql+asyncpg://localhost:5432/calendar
CALENDAR_LOG_LEVEL=INFO
CALENDAR_AUTO_CREATE_SCHEMA=false

# Four-eyes gate (D-10). Off until S-13 is answered.
CALENDAR_APPROVAL_REQUIRED=false

# Session auth for the UI (D-01: local username/password, no SSO)
# Unset falls back to a per-process key: sessions break on restart and across replicas (O-33).
CALENDAR_SESSION_SECRET=
CALENDAR_SESSION_IDLE_MINUTES=30
CALENDAR_SESSION_ABSOLUTE_MINUTES=480
CALENDAR_SESSION_COOKIE_SECURE=true

CALENDAR_PASSWORD_MIN_LENGTH=12
CALENDAR_LOCKOUT_THRESHOLD=5
CALENDAR_LOCKOUT_MINUTES=15

# --- Control Plane ---
CONTROL_PLANE_DB_URL=postgresql+asyncpg://localhost:5432/control_plane

# --- Airflow plugin (set in the BU Airflow environment, not here) ---
# CALENDAR_SERVICE_URL=https://calendar.internal.example
# CALENDAR_API_KEY=            # from AWS Secrets Manager; never commit (5.2)
# CALENDAR_CACHE_PATH=/opt/airflow/calendar_cache
