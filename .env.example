# Copy to .env and fill in. Never commit .env.

# --- Calendar Service ---
CALENDAR_DB_URL=sqlite+aiosqlite:///./calendar.db
CALENDAR_LOG_LEVEL=INFO
CALENDAR_AUTO_CREATE_SCHEMA=true
CALENDAR_UPLOAD_MAX_BYTES=5242880

# Local development only: false grants unauthenticated access. Enable before deployment.
CALENDAR_AUTH_ENABLED=false
CALENDAR_OAUTH_MODE=jwt
CALENDAR_OAUTH_ISSUER=
CALENDAR_OAUTH_AUDIENCE=
CALENDAR_OAUTH_JWKS_URL=
CALENDAR_OAUTH_ALGORITHM=RS256
CALENDAR_OAUTH_ROLE_CLAIM=roles
CALENDAR_OAUTH_ROLE_MAP='{"VIEWER":"VIEWER","EDITOR":"EDITOR","ADMIN":"ADMIN"}'
CALENDAR_OAUTH_USERNAME_CLAIM=preferred_username
# For opaque tokens, select introspection mode and configure the following:
# CALENDAR_OAUTH_INTROSPECTION_URL=
# CALENDAR_OAUTH_CLIENT_ID=
# CALENDAR_OAUTH_CLIENT_SECRET=

# --- Control Plane ---
CONTROL_PLANE_DB_URL=postgresql+asyncpg://localhost:5432/control_plane

# --- Airflow plugin (set in the BU Airflow environment, not here) ---
# CALENDAR_SERVICE_URL=https://calendar.internal.example
# CALENDAR_API_KEY=            # from AWS Secrets Manager; never commit (5.2)
# CALENDAR_CACHE_PATH=/opt/airflow/calendar_cache
