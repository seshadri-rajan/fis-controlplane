!*.tfvars.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local AI tooling installed per-machine, not part of this project
.agents/
skills-lock.json

# Client requirement documents. Excluded by default because repository visibility
# is unconfirmed; the decisions taken from them are captured in RECORD.md.
# To include them, delete these two lines and `git add` the files.
*.docx
