# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local databases
*.db
*.sqlite3

# Intermediate frames from the demo recorder; the GIF itself is committed
docs/demo/frames/

# Browser binaries a stray `playwright install` can drop in the working directory.
# The real install lives in %LOCALAPPDATA%\ms-playwright.
chrome/
chrome-headless-shell/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo
*.local

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local AI tooling installed per-machine, not part of this project
.agents/
.agents.zip
skills-lock.json

# Client requirement documents. Source documents under req-details/ are versioned on purpose;
# stray .docx elsewhere in the tree are not.
*.docx
!req-details/**/*.docx
